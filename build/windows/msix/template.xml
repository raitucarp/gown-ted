<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gown-ted.exe"
        Arguments=""
        InstallLocation="C:\Program Files\gown-ted">
    </Installer>
    <PackageInformation
        PackageName="gown-ted"
        PackageDisplayName="gown-ted"
        PublisherName="CN=Ribhararnus Pracutiar"
        PublisherDisplayName="Ribhararnus Pracutiar (@raitucarp)"
        Version="0.1.0.0"
        PackageDescription="The Intelligent Desktop Text Editor Infused with Princeton WordNet &amp; Computational Poetics">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.raitucarp.gownted"
                Description="The Intelligent Desktop Text Editor Infused with Princeton WordNet &amp; Computational Poetics"
                DisplayName="gown-ted"
                ExecutableName="gown-ted.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>gown-ted</DisplayName>
            <PublisherDisplayName>Ribhararnus Pracutiar (@raitucarp)</PublisherDisplayName>
            <Description>The Intelligent Desktop Text Editor Infused with Princeton WordNet &amp; Computational Poetics</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gown-ted.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
